{
  "name": "bookverse",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node -e \"try { require('vite') } catch(e) { require('child_process').execSync('npm install --legacy-peer-deps', { stdio: 'inherit' }) }\"",
    "start": "node server/server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server/server.js",
    "seed": "node server/seed_data.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongodb": "^6.8.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-icons": "^4.2.0",
    "vite": "^8.3.5"
  },
  "devDependencies": {}
}
